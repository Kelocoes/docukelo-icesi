#!/bin/sh
# Hook de pre-commit de DocuKelo: revisa los documentos modificados contra las reglas de la guia
# (.agents/memory/docusaurus-guidelines.md, seccion 10). Para ver el detalle de un fallo:
#   npm run lint:docs -- --changed --verbose
# Para saltarlo en un commit puntual (no recomendado): git commit --no-verify
node scripts/lint-docs.mjs --check --changed || {
    echo ""
    echo "pre-commit: corrige los incumplimientos de arriba (o corre 'npm run lint:docs -- --changed --verbose')."
    exit 1
}
# La copia del kit que sirve el sitio (static/interactive/_shared/) es generada desde la skill: no debe desviarse.
# Si falla: npm run kit:sync
node .agents/skills/docusaurus_animated_diagrams/host/install.mjs --check --no-frame --no-tests > /dev/null || {
    echo ""
    echo "pre-commit: static/interactive/_shared/ no coincide con .agents/skills/docusaurus_animated_diagrams/kit/. Edita el kit en la skill y corre 'npm run kit:sync'."
    exit 1
}
